# Required. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DROPSYNC_AUTH_CLIENT_KEY=replace-with-at-least-32-random-characters

# Public HTTPS address exposed by your reverse proxy. No trailing slash.
DROPSYNC_AUTH_PUBLIC_URL=https://auth.example.com

# Persistent state. Back this file up and keep it private.
DROPSYNC_AUTH_DATA_DIR=/var/lib/dropsync-auth
# Required for a public server: independent, persistent 32-byte base64 secret.
# Supply through your service secret store; back it up separately from the records.
DROPSYNC_AUTH_STORAGE_KEY=
DROPSYNC_AUTH_PORT=8787
DROPSYNC_AUTH_HOST=127.0.0.1

# Comma-separated browser origins. Android's asset origin is normally required.
DROPSYNC_AUTH_ALLOWED_ORIGINS=https://appassets.androidplatform.net
DROPSYNC_AUTH_ALLOW_LOOPBACK=true

# Exact OAuth return targets accepted by the service.
DROPSYNC_AUTH_REDIRECTS=dropsync://auth/callback,http://127.0.0.1:47821/index.html

# Optional social providers. A provider is enabled only when both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional company SSO (OIDC authorization code + PKCE; secrets stay server-side).
DROPSYNC_OIDC_ISSUER=
DROPSYNC_OIDC_CLIENT_ID=
DROPSYNC_OIDC_CLIENT_SECRET=
DROPSYNC_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Additional HTTPS origins only when your reviewed IdP uses separate endpoints.
DROPSYNC_OIDC_ALLOWED_ORIGINS=

# One organization per auth-server instance. Setting an ID requires OIDC.
DROPSYNC_ORG_ID=
DROPSYNC_ORG_NAME=
DROPSYNC_ORG_ALLOWED_DOMAINS=
DROPSYNC_ORG_ADMIN_EMAILS=
# Defaults to true when an organization exists; do not set false for company SSO.
# DROPSYNC_ORG_REQUIRE_SSO=true
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
DROPSYNC_AUTH_TRUST_PROXY=false
